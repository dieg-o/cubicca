# Runtime (app / Prisma Client): SIEMPRE el pooler en 6543 con pgbouncer=true.
#
# uselibpqcompat=true es obligatorio: desde pg@8.22, `sslmode=require` se trata
# como `verify-full`, y el cert del pooler de Supabase no valida contra los CAs
# del sistema (self-signed certificate in certificate chain). Este flag restaura
# la semántica libpq — conexión encriptada, sin verificar la cadena.
# Solo aplica al runtime: `prisma migrate` va por el schema engine, que no cambió.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&uselibpqcompat=true"

# Migraciones (prisma migrate) ÚNICAMENTE: conexión directa 5432, sin pgbouncer.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase Auth (Project Settings -> API). Ambas son NEXT_PUBLIC_ a propósito:
# viajan al browser y son seguras de exponer — la anon key no da acceso a nada
# por sí sola, la autorización real la imponen las políticas RLS y la sesión.
# NUNCA poner acá la service_role key: esa bypassea RLS y no va al cliente.
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# Supabase service_role (Project Settings -> API). BYPASSEA RLS Y TODA POLÍTICA.
#
# ⚠️ SIN prefijo NEXT_PUBLIC_, y que nunca lo tenga: las NEXT_PUBLIC_* se
# inlinean en el bundle del cliente en build time. La usa un solo módulo,
# `src/lib/supabase/admin.ts`, que arranca con `import "server-only"` para que
# el build FALLE si algún client component la importa por accidente.
#
# Para qué: mintear URLs firmadas del bucket privado `plans` (subida y lectura).
# La autorización de tenant NO la pone Storage, la pone la app: toda operación
# se firma recién después de validar la pertenencia con getTenantPrisma(orgId).
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# OPCIONAL. Origin público de la app, sin barra final. Se usa para armar el
# `emailRedirectTo` del mail de confirmación (`<origin>/auth/callback`). Si no
# está, se cae al header `Origin` del request, que en dev alcanza. En prod
# conviene fijarlo para no depender de headers.
# La URL tiene que estar en Authentication -> URL Configuration -> Redirect URLs
# del dashboard de Supabase, o el canje del code se rechaza.
# NEXT_PUBLIC_SITE_URL="https://cubicca.com"
