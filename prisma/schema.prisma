generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma v7: el datasource NO lleva `url`. La URL vive exclusivamente en
// prisma.config.ts — declararla acá tira P1012.
datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

/// Ciclo de vida de un plano. PENDING = la fila existe y hay una signed upload
/// URL emitida, pero los bytes todavía no están confirmados en Storage. READY =
/// el objeto existe (verificado server-side) y el diagnóstico está persistido.
enum PlanStatus {
  PENDING
  READY
}

/// Las tres formas de medir sobre un plano, y lo que devuelve cada una:
///   LARGO_CONTINUO -> metros    (polilínea)
///   MURO           -> m²        (polilínea × alto)
///   AREA           -> m²        (polígono cerrado)
enum MeasurementType {
  LARGO_CONTINUO
  MURO
  AREA
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profiles     Profile[]
  projects     Project[]
  plans        Plan[]
  measurements Measurement[]

  @@map("organizations")
}

model Profile {
  id String @id @default(uuid()) @db.Uuid

  // Source of truth de identidad = auth.users (Supabase Auth).
  // Prisma nunca toca el schema `auth`: esto es una referencia lógica, sin FK.
  userId String @unique @map("user_id") @db.Uuid

  organizationId String @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email     String
  fullName  String?  @map("full_name")
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("profiles")
}

// Primer modelo tenant-scoped. Todo modelo con `organizationId` DEBE estar
// listado en TENANT_SCOPED_MODELS (src/lib/db/tenant.ts): si no está, sus
// queries no quedan aisladas. Ver el test scripts/test-tenant-isolation.ts.
model Project {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name String

  /// Altura de escantillón por defecto (metros) para el cómputo de muros del
  /// proyecto. Se define al crearlo y cada plano lo hereda cuando haga falta.
  escantillonDefault Float @default(2.4) @map("escantillon_default")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plans Plan[]

  @@index([organizationId])
  @@map("projects")
}

/// Un PDF de plano subido a un proyecto.
///
/// Los bytes NO viven acá ni pasan nunca por el server: van directo del browser
/// a Supabase Storage (bucket privado `plans`) vía signed upload URL. Esta fila
/// guarda el puntero al objeto (`storagePath`) y el diagnóstico vector/raster.
model Plan {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Clave del objeto en el bucket: '{orgId}/{projectId}/{planId}.pdf'. Lleva el
  /// orgId adelante para que un listado por prefijo ya quede acotado al tenant.
  storagePath      String @map("storage_path")
  originalFilename String @map("original_filename")
  contentType      String @map("content_type")
  fileSizeBytes    Int    @map("file_size_bytes")

  /// Metadata del diagnóstico. Nullable porque un plan PENDING todavía no la
  /// tiene: se completa recién en finalizePlanUpload.
  pageCount         Int?     @map("page_count")
  hasVectorGeometry Boolean? @map("has_vector_geometry")
  diagnosisJson     Json?    @map("diagnosis_json")

  /// Calibración de escala: METROS por unidad de user-space del PDF.
  /// `null` = sin calibrar. Es lo único que hace falta para medir: longitud
  /// real = longitud_pdf × scaleFactor, área real = área_pdf × scaleFactor².
  scaleFactor Float? @map("scale_factor")

  /// Registro auditable de CÓMO se derivó ese factor: página, los dos puntos
  /// en user-space, el valor y la unidad que tipeó el usuario, y la distancia
  /// PDF medida. Sin esto, un factor sospechoso no se puede revisar ni
  /// recalcular; con esto, se rehace la cuenta sin volver a marcar nada.
  calibrationJson Json? @map("calibration_json")

  status    PlanStatus @default(PENDING)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  measurements Measurement[]

  @@index([organizationId])
  @@index([projectId])
  @@map("plans")
}

/// Una medición dibujada sobre un plano calibrado.
///
/// `computedValue` es el resultado en unidades REALES y lo calcula siempre el
/// servidor a partir de `geometryJson` + el `scaleFactor` del plano: el valor
/// que muestra el cliente mientras dibuja es preview y nunca se persiste.
/// Guardar los puntos y no solo el número es lo que permite recalcular todo si
/// mañana se corrige la calibración del plano.
model Measurement {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  planId String @map("plan_id") @db.Uuid
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  type MeasurementType

  /// 0-based. Tiene que coincidir con la página sobre la que se calibró: un
  /// scaleFactor derivado de la planta no dice nada sobre un detalle en otra hoja.
  pageIndex Int @map("page_index")

  /// Los vértices en USER-SPACE del PDF: [{x,y},…]. Nunca píxeles.
  geometryJson Json @map("geometry_json")

  /// Metros para LARGO_CONTINUO, m² para MURO y AREA.
  computedValue Float @map("computed_value")

  /// Altura en metros. Solo para MURO; para el resto es null.
  alto Float?

  /// Etiqueta libre del usuario. El catálogo de partidas es TD-006.
  label String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([planId])
  @@map("measurements")
}
